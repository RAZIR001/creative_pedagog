  <script>
    // SLIDER
    const slider = document.getElementById("slider");
    const dots = document.querySelectorAll(".dot");
    const totalSlides = dots.length;
    let currentSlideIndex = 0;
    let sliderTimer;

    function showSlide(index) {
      currentSlideIndex = (index + totalSlides) % totalSlides;

      slider.style.transform =
        `translateX(-${currentSlideIndex * 100}%)`;

      dots.forEach((dot, i) => {
        dot.classList.toggle("active", i === currentSlideIndex);
        dot.setAttribute(
          "aria-current",
          i === currentSlideIndex ? "true" : "false"
        );
      });
    }

    function moveSlide(step) {
      showSlide(currentSlideIndex + step);
    }

    function startSlider() {
      clearInterval(sliderTimer);
      sliderTimer = setInterval(() => moveSlide(1), 5000);
    }

    document.getElementById("prevSlide").addEventListener("click", () => {
      moveSlide(-1);
      startSlider();
    });

    document.getElementById("nextSlide").addEventListener("click", () => {
      moveSlide(1);
      startSlider();
    });

    dots.forEach(dot => {
      dot.addEventListener("click", () => {
        showSlide(Number(dot.dataset.index));
        startSlider();
      });
    });

    const sliderSection = document.querySelector(".slider-section");

    sliderSection.addEventListener("mouseenter", () => {
      clearInterval(sliderTimer);
    });

    sliderSection.addEventListener("mouseleave", startSlider);

    showSlide(0);
    startSlider();

    // FILTERS + SEARCH
    const filterButtons = document.querySelectorAll(".filter-btn");
    const materialCards = document.querySelectorAll(".material-card");
    const searchInput = document.getElementById("searchInput");
    const emptyMessage = document.getElementById("emptyMessage");

    let activeCategory = "all";

    function updateMaterials() {
      const searchText = searchInput.value
        .trim()
        .toLocaleLowerCase("uz");

      let visibleCount = 0;

      materialCards.forEach(card => {
        const category = card.dataset.category;
        const text = card.textContent.toLocaleLowerCase("uz");

        const categoryMatches =
          activeCategory === "all" || category === activeCategory;

        const searchMatches = text.includes(searchText);
        const isVisible = categoryMatches && searchMatches;

        card.hidden = !isVisible;

        if (isVisible) visibleCount++;
      });

      emptyMessage.style.display =
        visibleCount === 0 ? "block" : "none";
    }

    filterButtons.forEach(button => {
      button.addEventListener("click", () => {
        activeCategory = button.dataset.filter;

        filterButtons.forEach(btn => {
          btn.classList.toggle("active", btn === button);
        });

        updateMaterials();
      });
    });

    searchInput.addEventListener("input", updateMaterials);

    // CATEGORY LINKS
    document.querySelectorAll("[data-filter-category]").forEach(link => {
      link.addEventListener("click", () => {
        activeCategory = link.dataset.filterCategory;

        filterButtons.forEach(button => {
          button.classList.toggle(
            "active",
            button.dataset.filter === activeCategory
          );
        });

        updateMaterials();
      });
    });

    // MOBILE MENU
    const menuToggle = document.getElementById("menuToggle");
    const navMenu = document.getElementById("navMenu");

    menuToggle.addEventListener("click", () => {
      const isOpen = navMenu.classList.toggle("open");

      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.innerHTML = isOpen
        ? '<i class="fa-solid fa-xmark"></i>'
        : '<i class="fa-solid fa-bars"></i>';
    });

    document.querySelectorAll(".nav-link").forEach(link => {
      link.addEventListener("click", () => {
        navMenu.classList.remove("open");
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.innerHTML = '<i class="fa-solid fa-bars"></i>';
      });
    });

    // CURRENT YEAR
    document.getElementById("currentYear").textContent =
      new Date().getFullYear();
  </script>
</body>
</html>
